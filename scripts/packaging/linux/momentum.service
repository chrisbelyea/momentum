[Unit]
Description=Momentum task server (per-user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/momentum-server
Environment=DB_PATH=%h/.config/Momentum/momentum.db
Environment=PORT=8080
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/Momentum

[Install]
WantedBy=default.target
