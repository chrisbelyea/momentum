[Unit]
Description=Momentum task server (per-user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@MOMENTUM_BINARY@
EnvironmentFile=-@MOMENTUM_ENV_FILE@
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MOMENTUM_DATA_DIR@

[Install]
WantedBy=default.target
