<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- 
        Initial database schema for Momentum
        
        This changeset creates the core tables needed for:
        - User accounts and authentication
        - Backend configurations (CalDAV, etc.)
        - Local task storage and sync state
    -->

    <changeSet id="001-create-users-table" author="momentum">
        <comment>Create users table for authentication and authorization</comment>
        <createTable tableName="users">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-backends-table" author="momentum">
        <comment>Create backends table for task source configurations</comment>
        <createTable tableName="backends">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="backend_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="config_encrypted" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint 
            baseTableName="backends" 
            baseColumnNames="user_id"
            constraintName="fk_backends_user"
            referencedTableName="users"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="RESTRICT"/>
        <createIndex tableName="backends" indexName="idx_backends_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-create-tasks-table" author="momentum">
        <comment>Create tasks table for local task storage and caching</comment>
        <createTable tableName="tasks">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="backend_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER" defaultValue="0">
                <constraints nullable="false"/>
            </column>
            <column name="due_date" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="vtodo_data" type="TEXT">
                <constraints nullable="true"/>
            </column>
            <column name="sync_status" type="VARCHAR(50)" defaultValue="synced">
                <constraints nullable="false"/>
            </column>
            <column name="last_synced_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint 
            baseTableName="tasks" 
            baseColumnNames="backend_id"
            constraintName="fk_tasks_backend"
            referencedTableName="backends"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="RESTRICT"/>
        <createIndex tableName="tasks" indexName="idx_tasks_backend_id">
            <column name="backend_id"/>
        </createIndex>
        <createIndex tableName="tasks" indexName="idx_tasks_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="tasks" indexName="idx_tasks_due_date">
            <column name="due_date"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
